# === S3-Compatible Object Storage (SeaweedFS) ===
# S3-compatible object storage for document files (PDFs).
# Defaults target a local SeaweedFS instance (port 8333).
# Can be pointed at any S3-compatible service (SeaweedFS, MinIO, AWS S3).
S3_ENDPOINT=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET_NAME=aicpx-documents
S3_ROOT_USER=aicpx_s3_access     # also used for SeaweedFS setup
S3_ROOT_PASSWORD=change-me-strong-secret  # also used for SeaweedFS setup

# Local SeaweedFS publish port (for host access)
S3_API_PORT=8333

# === MongoDB ===
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=aicpx
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongodb_password
# Optional: authenticate against a different database (e.g. admin) than the target
# MONGO_AUTH_SOURCE=admin

# === Langfuse ===
LANGFUSE_SECRET_KEY=your-langfuse-api-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-api-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini # gpt-5-mini
OPENAI_TEMPERATURE=1 # GPT-5 models don't support temperature, it should be 1 if using GPT-5
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=120

# === Security ===
# When false, evidence document URLs are returned as null so browser users
# do not receive internal S3-compatible storage URLs.
AI_CPX_PUBLIC_DOCUMENT_URLS=false

# === Risk Identifier Service ===
RISK_TYPES_VERSION=1.0.0

# DEV or PROD
APP_MODE=DEV

# === DEV Mode Settings (token usage limits) ===
DEV_MAX_PROJECTS=3                         # Process first N projects (alphabetically sorted)
DEV_MAX_DOCUMENTS_PER_PROJECT=2            # Process first N documents per project
DEV_MAX_CHUNKS_PER_PROJECT=10              # Process first N chunks per project
DEV_MAX_RISK_TYPES=3                       # Process first N risk types (alphabetically sorted)
DEV_SKIP_PROJECT_SUMMARIES=false           # Skip expensive project-level LLM summaries
DEV_SKIP_RISK_ASSESSMENT_SUMMARIES=false   # Skip risk assessment LLM summaries
