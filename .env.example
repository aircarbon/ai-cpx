# === S3/MinIO ===
# For connecting to S3 bucket
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=test-bucket
S3_ROOT_USER=admin # also used for setup
S3_ROOT_PASSWORD=minio_password # also used for setup

# For setting up MinIO S3 bucket
S3_API_PORT=9100
S3_CONSOLE_PORT=9101

# === MongoDB ===
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=aicpx
MONGO_INITDB_ROOT_USERNAME=mongoadmin
MONGO_INITDB_ROOT_PASSWORD=mongodb_password

# Langfuse
LANGFUSE_SECRET_KEY=your-langfuse-api-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-api-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini # gpt-5-mini
OPENAI_TEMPERATURE=1 # GPT-5 models don't support temperature, it should be 1 if using GPT-5
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT=120

# === Risk Identifier Service ===
RISK_TYPES_VERSION=1.0.0