# === Canonical image for AI CPX ===
#
# This single image is reused by all AI CPX components (API, docparser,
# risk calculator, DB init) with overridden commands in Kubernetes.
#
# Build:
#   docker buildx build --platform linux/amd64 \
#     -f docker/Dockerfile.api \
#     -t ghcr.io/aircarbon/ai-cpx:<tag> \
#     --push .
#
# Requires: uv.lock and pyproject.toml at the repo root.

FROM python:3.12.3-slim

# Install uv (official Astral install)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# Create and set the working directory in the container
WORKDIR /app

# Install dependencies (layer caching via uv.lock)
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-dev --no-editable

# Copy the rest of the application into the container
COPY . /app/

# Default: run the API service
# Override CMD for other components:
#   docparser:    python -m app.services.doc_parser.doc_parser
#   risk-calc:    python -m app.services.risk_calculator.risk_calculator
#   db-init:      python scripts/init_db.py
CMD ["uvicorn", "app.services.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
