# Test setup image — uses the same canonical deps but with dev extras for test scripts.
FROM python:3.12.3-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install all dependencies including dev extras
COPY pyproject.toml uv.lock /app/
RUN uv sync --frozen --no-editable

# Copy the rest of the application into the container
COPY . /app/

# Copy the test environment file as .env (after copying app to ensure it overwrites)
COPY .env.test /app/.env

ENTRYPOINT ["python", "scripts/test/test_setup.py"]
